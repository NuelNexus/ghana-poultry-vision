[Unit]
Description=PoultryGrid HTTPS on port 8443 (so other devices can use the microphone)
After=network-online.target poultrygrid-web.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
Environment=PATH=@NODE_DIR@:/usr/local/bin:/usr/bin:/bin
# Re-issues the certificate if the Pi's IP changed (same CA, so phones keep trusting it)
ExecStartPre=/bin/bash @REPO@/scripts/make-cert.sh
ExecStart=@NODE_DIR@/node scripts/https-proxy.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
