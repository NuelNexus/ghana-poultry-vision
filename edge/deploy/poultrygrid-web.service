[Unit]
Description=PoultryGrid web app (vite dev server on port 8080)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
Environment=PATH=@NODE_DIR@:/usr/local/bin:/usr/bin:/bin
ExecStart=@NODE_DIR@/npm run dev -- --host 0.0.0.0
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
