# Copy to /etc/poultrygrid/agent.env (the installer does this for you).
# Get the device ID and API key from Devices -> Register device in the app.
PG_API_URL=https://your-app.example.com
PG_DEVICE_ID=PI-HOUSE-A
PG_DEVICE_API_KEY=

# Seconds between readings
PG_INTERVAL_S=30

# Flock age. The app sends this automatically once the Pi is assigned to a
# house with a "chicks placed on" date; these are fallbacks for offline use.
# PG_BATCH_START_DATE=2026-09-26
# PG_BIRD_AGE_DAYS=21

# MQ-135 clean-air voltage; measure with: python agent.py calibrate
PG_MQ135_BASELINE_V=0.6
# 1 if the LDR module's voltage drops as light increases (most LM393 boards)
PG_LDR_INVERT=1

# Pins (BCM numbering) - defaults match the original wiring
# PG_DHT_PIN=4
# PG_FAN_PWM_PIN=18
# PG_FAN_TACH_PIN=23
# PG_FAN_PWM_HZ=25000

# Set to 0 to monitor only and leave the fan alone
PG_FAN_AUTO=1
