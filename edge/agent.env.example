# Copy to /etc/poultrygrid/agent.env (the installer does this for you).
# Get the device ID and API key from Devices -> Register device in the app.
PG_API_URL=https://your-app.example.com
PG_DEVICE_ID=PI-HOUSE-A
PG_DEVICE_API_KEY=

# Seconds between readings
PG_INTERVAL_S=30

# Flock age. The app sends this automatically once the Pi is assigned to a
# house with a "chicks placed on" date; these are fallbacks for offline use.
# PG_BATCH_START_DATE=2026-09-26
# PG_BIRD_AGE_DAYS=21

# MQ-135 clean-air voltage (ADS1115 only); measure with: python agent.py calibrate
PG_MQ135_BASELINE_V=0.6
# 1 if the LDR module's output drops as light increases (most LM393 boards)
PG_LDR_INVERT=1

# Pins (BCM numbering)
# PG_DHT_PIN=4
# Fan: "relay" (relay module on PG_FAN_RELAY_PIN) or "pwm" (4-pin PWM fan's
# PWM wire straight to PG_FAN_PWM_PIN, no relay)
# PG_FAN_MODE=relay
# PG_FAN_RELAY_PIN=18
# PG_FAN_PWM_PIN=18
# Duty for "on" (0-1); "off" is 0
# PG_FAN_PWM_DUTY=1.0
# 1 if the PWM line goes through an inverting MOSFET/transistor
# PG_FAN_PWM_INVERT=0
# 1 for the usual relay modules that switch ON when IN is pulled LOW
# PG_RELAY_ACTIVE_LOW=1
# Minimum seconds between relay switches (stops the contacts chattering)
# PG_RELAY_MIN_SWITCH_S=60

# MQ-135 and LDR: "auto" uses an ADS1115 if one answers on I2C, otherwise
# the modules' DO pins below. Force with "ads1115" or "digital", or "none"
# while they aren't wired yet (gas and light show as not connected).
# PG_SENSOR_MODE=auto
# PG_GAS_DO_PIN=17
# PG_LDR_DO_PIN=27

# Set to 0 to monitor only and never switch the fan relay
PG_FAN_AUTO=1
